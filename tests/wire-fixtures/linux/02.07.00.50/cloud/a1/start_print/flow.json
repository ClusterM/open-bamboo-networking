{
  "schema": "obn-wire-flow/v1",
  "meta": {
    "os": "linux",
    "network_plugin_version": "02.07.00.50",
    "slicer_client_version": "02.07.00.55",
    "channel": "cloud",
    "printer_model": "a1",
    "flow": "start_print",
    "source": "BambuStudio"
  },
  "identity_block": {
    "order": [
      "Host",
      "User-Agent",
      "X-BBL-Client-ID",
      "X-BBL-Client-Name",
      "X-BBL-Client-Type",
      "X-BBL-Client-Version",
      "X-BBL-Device-ID",
      "X-BBL-Language",
      "X-BBL-OS-Type",
      "X-BBL-OS-Version",
      "X-BBL-Agent-Version",
      "X-BBL-Executable-info",
      "X-BBL-Agent-OS-Type",
      "X-BBL-Executable-Env",
      "accept",
      "Authorization",
      "Content-Type"
    ],
    "values": {
      "Host": "api.bambulab.com",
      "User-Agent": "bambu_network_agent/02.07.00.50",
      "X-BBL-Client-ID": "<dynamic:slicer:{user_id}:{hex4}>",
      "X-BBL-Client-Name": "BambuStudio",
      "X-BBL-Client-Type": "slicer",
      "X-BBL-Client-Version": "02.07.00.55",
      "X-BBL-Device-ID": "<dynamic:install-uuid>",
      "X-BBL-Language": "en-US",
      "X-BBL-OS-Type": "linux",
      "X-BBL-OS-Version": "5.15.0",
      "X-BBL-Agent-Version": "02.07.00.50",
      "X-BBL-Executable-info": "{}",
      "X-BBL-Agent-OS-Type": "linux",
      "X-BBL-Executable-Env": "false",
      "accept": "application/json",
      "Authorization": "<dynamic:Bearer access_token>",
      "Content-Type": "application/json"
    }
  },
  "vars": {
    "job_name": {
      "kind": "input",
      "example": "box20"
    },
    "plate_index": {
      "kind": "input",
      "example": 1
    },
    "device_id": {
      "kind": "session",
      "example": "030000000000001"
    },
    "user_id": {
      "kind": "session",
      "example": "1234567890"
    },
    "project_id": {
      "kind": "from_response",
      "step": "create_project",
      "json": "$.project_id",
      "example": "899112871"
    },
    "profile_id": {
      "kind": "from_response",
      "step": "create_project",
      "json": "$.profile_id",
      "example": "874668027"
    },
    "model_id": {
      "kind": "from_response",
      "step": "create_project",
      "json": "$.model_id",
      "example": "US00000000000001"
    },
    "upload_url": {
      "kind": "from_response",
      "step": "create_project",
      "json": "$.upload_url",
      "example": "<presigned S3 url>"
    },
    "upload_ticket": {
      "kind": "from_response",
      "step": "create_project",
      "json": "$.upload_ticket",
      "example": "uploader_1234567890_US00000000000001_874668027_20260714203450.33"
    },
    "config_file_name": {
      "kind": "generated",
      "example": ".1748171.1_config.3mf"
    },
    "gcode_md5": {
      "kind": "input",
      "example": "7F191499E8670888399F7574D1E9AF5E"
    },
    "main_upload_url": {
      "kind": "from_response",
      "step": "get_upload_url",
      "json": "$.urls[0].url",
      "example": "https://s3.us-west-2.amazonaws.com/or-cloud-upload-prod/users/1234567890/models/.../US00000000000001_874668027_1.3mf?AWSAccessKeyId=...&Expires=...&Signature=..."
    },
    "seq": {
      "kind": "generated",
      "example": "20004"
    },
    "task_id": {
      "kind": "from_response",
      "step": "create_task",
      "json": "$.id",
      "example": "1090332016"
    }
  },
  "driver": {
    "project_name": "box20",
    "dev_id": "030000000000001",
    "plate_index": 1,
    "task_bed_type": "textured_plate",
    "task_use_ams": true,
    "task_record_timelapse": false,
    "task_layer_inspect": true,
    "task_bed_leveling": true,
    "task_flow_cali": true,
    "task_vibration_cali": false,
    "auto_bed_leveling": 1,
    "auto_flow_cali": 1,
    "auto_offset_cali": 2,
    "extruder_cali_manual_mode": 0,
    "ftp_file_md5": "7F191499E8670888399F7574D1E9AF5E",
    "ams_mapping": "[2,1]",
    "ams_mapping2": "[{\"ams_id\":0,\"slot_id\":2},{\"ams_id\":0,\"slot_id\":1}]",
    "ams_mapping_info": "[{\"ams\":2,\"filamentId\":\"GFG00\",\"filamentType\":\"PETG\",\"nozzleId\":1,\"sourceColor\":\"#161616FF\",\"targetColor\":\"D6001CFF\"},{\"ams\":1,\"filamentId\":\"GFG00\",\"filamentType\":\"PETG\",\"nozzleId\":1,\"sourceColor\":\"#FFF144FF\",\"targetColor\":\"FFFFFFFF\"}]",
    "nozzles_info": "",
    "asset": "assets/box20.gcode.3mf",
    "config_asset": "assets/box20_config.3mf"
  },
  "steps": [
    {
      "seq": 1,
      "id": "create_project",
      "protocol": "http",
      "request": {
        "method": "POST",
        "host": "api.bambulab.com",
        "path": "/v1/iot-service/api/user/project",
        "headers": {
          "block": true,
          "client_id": true,
          "content_type": true,
          "authorization": true
        },
        "body_json": {
          "name": "box20"
        }
      },
      "expect": {
        "status": 200
      },
      "captures": {
        "project_id": "$.project_id",
        "profile_id": "$.profile_id",
        "model_id": "$.model_id",
        "upload_url": "$.upload_url",
        "upload_ticket": "$.upload_ticket"
      }
    },
    {
      "seq": 2,
      "id": "upload_config_3mf",
      "protocol": "http",
      "request": {
        "method": "PUT",
        "host": "<presigned>",
        "path": "{{upload_url}}",
        "headers": {
          "block": false,
          "content_type_removed": true,
          "expect_removed": true
        },
        "body_raw": "<config .3mf bytes>"
      },
      "expect": {
        "status": 200
      }
    },
    {
      "seq": 3,
      "id": "notify_upload",
      "protocol": "http",
      "request": {
        "method": "PUT",
        "host": "api.bambulab.com",
        "path": "/v1/iot-service/api/user/notification",
        "headers": {
          "block": true,
          "client_id": true,
          "content_type": true,
          "authorization": true
        },
        "body_json": {
          "upload": {
            "origin_file_name": "{{config_file_name}}",
            "ticket": "{{upload_ticket}}"
          }
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "seq": 4,
      "id": "poll_upload",
      "protocol": "http",
      "repeatable": true,
      "request": {
        "method": "GET",
        "host": "api.bambulab.com",
        "path": "/v1/iot-service/api/user/notification",
        "query": {
          "action": "upload",
          "ticket": "{{upload_ticket}}"
        },
        "headers": {
          "block": true,
          "client_id": true,
          "content_type": false,
          "authorization": true
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "seq": 5,
      "id": "patch_project_placeholder",
      "protocol": "http",
      "channel_only": "cloud_lan",
      "request": {
        "method": "PATCH",
        "host": "api.bambulab.com",
        "path": "/v1/iot-service/api/user/project/{{project_id}}",
        "headers": {
          "block": true,
          "client_id": true,
          "content_type": true,
          "authorization": true
        },
        "body_json": {
          "profile_id": "{{profile_id}}",
          "profile_print_3mf": [
            {
              "md5": "{{gcode_md5}}",
              "plate_idx": "{{plate_index}}",
              "url": "ftp://box20.gcode.3mf"
            }
          ]
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "seq": 6,
      "id": "get_my_setting",
      "protocol": "http",
      "channel_only": "cloud_lan",
      "request": {
        "method": "GET",
        "host": "api.bambulab.com",
        "path": "/v1/user-service/my/setting",
        "headers": {
          "block": true,
          "client_id": true,
          "content_type": true,
          "authorization": true
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "seq": 7,
      "id": "get_upload_url",
      "protocol": "http",
      "request": {
        "method": "GET",
        "host": "api.bambulab.com",
        "path": "/v1/iot-service/api/user/upload",
        "query": {
          "models": "{{model_id}}_{{profile_id}}_{{plate_index}}.3mf"
        },
        "headers": {
          "block": true,
          "client_id": true,
          "content_type": false,
          "authorization": true
        }
      },
      "expect": {
        "status": 200
      },
      "captures": {
        "main_upload_url": "$.urls[0].url"
      }
    },
    {
      "seq": 8,
      "id": "upload_main_3mf",
      "protocol": "http",
      "request": {
        "method": "PUT",
        "host": "<presigned>",
        "path": "{{main_upload_url}}",
        "headers": {
          "block": false,
          "content_type_removed": true,
          "expect_removed": true
        },
        "body_raw": "<print-ready .3mf (with gcode) bytes>"
      },
      "expect": {
        "status": 200
      }
    },
    {
      "seq": 9,
      "id": "patch_project_real",
      "protocol": "http",
      "request": {
        "method": "PATCH",
        "host": "api.bambulab.com",
        "path": "/v1/iot-service/api/user/project/{{project_id}}",
        "headers": {
          "block": true,
          "client_id": true,
          "content_type": true,
          "authorization": true
        },
        "body_json": {
          "profile_id": "{{profile_id}}",
          "profile_print_3mf": [
            {
              "md5": "{{gcode_md5}}",
              "plate_idx": "{{plate_index}}",
              "url": "{{main_upload_url}}"
            }
          ]
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "seq": 10,
      "id": "create_task",
      "protocol": "http",
      "body_builder": true,
      "request": {
        "method": "POST",
        "host": "api.bambulab.com",
        "path": "/v1/user-service/my/task",
        "headers": {
          "block": true,
          "client_id": true,
          "content_type": true,
          "authorization": true
        },
        "body_json": {
          "amsDetailMapping": [
            {
              "ams": 2,
              "filamentId": "GFG00",
              "filamentType": "PETG",
              "nozzleId": 1,
              "sourceColor": "#161616FF",
              "targetColor": "D6001CFF"
            },
            {
              "ams": 1,
              "filamentId": "GFG00",
              "filamentType": "PETG",
              "nozzleId": 1,
              "sourceColor": "#FFF144FF",
              "targetColor": "FFFFFFFF"
            }
          ],
          "amsMapping": [
            2,
            1
          ],
          "amsMapping2": [
            {
              "amsId": 0,
              "slotId": 2
            },
            {
              "amsId": 0,
              "slotId": 1
            }
          ],
          "autoBedLeveling": 1,
          "bedLeveling": true,
          "bedType": "textured_plate",
          "cfg": "0",
          "cover": "",
          "deviceId": "030000000000001",
          "extrudeCaliFlag": 1,
          "extrudeCaliManualMode": 0,
          "filamentSettingIds": [],
          "flowCali": true,
          "layerInspect": true,
          "mode": "cloud_file",
          "modelId": "{{model_id}}",
          "nozzleInfos": [],
          "nozzleOffsetCali": 2,
          "oriModelId": "",
          "oriProfileId": 0,
          "plateIndex": 1,
          "profileId": "{{profile_id}}",
          "sequence_id": "{{seq}}",
          "timelapse": false,
          "title": "box20",
          "useAms": true,
          "vibrationCali": false
        }
      },
      "expect": {
        "status": 200
      },
      "captures": {
        "task_id": "$.id"
      }
    },
    {
      "seq": 11,
      "id": "poll_task",
      "protocol": "http",
      "repeatable": true,
      "request": {
        "method": "GET",
        "host": "api.bambulab.com",
        "path": "/v1/user-service/my/task/{{task_id}}",
        "headers": {
          "block": true,
          "client_id": true,
          "content_type": false,
          "authorization": true
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "seq": 12,
      "id": "mqtt_publish_project_file",
      "protocol": "mqtt",
      "channel_only": "cloud_lan",
      "request": {
        "topic": "device/{{device_id}}/request",
        "payload_hint": "print.project_file (lan channel)"
      },
      "expect": {}
    }
  ]
}
