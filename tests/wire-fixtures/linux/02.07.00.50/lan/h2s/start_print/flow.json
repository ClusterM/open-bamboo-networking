{
  "schema": "obn-wire-flow/v1",
  "meta": {
    "os": "linux",
    "network_plugin_version": "02.07.00.50",
    "slicer_client_version": "02.07.00.55",
    "channel": "lan",
    "printer_model": "h2s",
    "flow": "start_print",
    "source": "BambuStudio"
  },
  "identity_block": {
    "order": [
      "Host",
      "User-Agent",
      "X-BBL-Client-ID",
      "X-BBL-Client-Name",
      "X-BBL-Client-Type",
      "X-BBL-Client-Version",
      "X-BBL-Device-ID",
      "X-BBL-Language",
      "X-BBL-OS-Type",
      "X-BBL-OS-Version",
      "X-BBL-Agent-Version",
      "X-BBL-Executable-info",
      "X-BBL-Agent-OS-Type",
      "X-BBL-Executable-Env",
      "accept",
      "Authorization",
      "Content-Type"
    ],
    "values": {
      "Host": "api.bambulab.com",
      "User-Agent": "bambu_network_agent/02.07.00.50",
      "X-BBL-Client-ID": "<dynamic:slicer:{user_id}:{hex4}>",
      "X-BBL-Client-Name": "BambuStudio",
      "X-BBL-Client-Type": "slicer",
      "X-BBL-Client-Version": "02.07.00.55",
      "X-BBL-Device-ID": "<dynamic:install-uuid>",
      "X-BBL-Language": "en-US",
      "X-BBL-OS-Type": "linux",
      "X-BBL-OS-Version": "5.15.0",
      "X-BBL-Agent-Version": "02.07.00.50",
      "X-BBL-Executable-info": "{}",
      "X-BBL-Agent-OS-Type": "linux",
      "X-BBL-Executable-Env": "false",
      "accept": "application/json",
      "Authorization": "<dynamic:Bearer access_token>",
      "Content-Type": "application/json"
    }
  },
  "vars": {
    "job_name": {
      "kind": "input",
      "example": "box20"
    },
    "plate_index": {
      "kind": "input",
      "example": 1
    },
    "device_id": {
      "kind": "session",
      "example": "090000000000001"
    },
    "user_id": {
      "kind": "session",
      "example": "1234567890"
    },
    "project_id": {
      "kind": "from_response",
      "step": "create_project",
      "json": "$.project_id",
      "example": "899112871"
    },
    "profile_id": {
      "kind": "from_response",
      "step": "create_project",
      "json": "$.profile_id",
      "example": "874668027"
    },
    "model_id": {
      "kind": "from_response",
      "step": "create_project",
      "json": "$.model_id",
      "example": "US00000000000001"
    },
    "upload_url": {
      "kind": "from_response",
      "step": "create_project",
      "json": "$.upload_url",
      "example": "<presigned S3 url>"
    },
    "upload_ticket": {
      "kind": "from_response",
      "step": "create_project",
      "json": "$.upload_ticket",
      "example": "uploader_1234567890_US00000000000001_874668027_20260714203450.33"
    },
    "config_file_name": {
      "kind": "generated",
      "example": ".1748171.1_config.3mf"
    },
    "gcode_md5": {
      "kind": "input",
      "example": "C243A8A7648BDB3ECF89978D795105B7"
    },
    "main_upload_url": {
      "kind": "from_response",
      "step": "get_upload_url",
      "json": "$.urls[0].url",
      "example": "https://s3.us-west-2.amazonaws.com/or-cloud-upload-prod/users/1234567890/models/.../US00000000000001_874668027_1.3mf?AWSAccessKeyId=...&Expires=...&Signature=..."
    },
    "seq": {
      "kind": "generated",
      "example": "20001"
    },
    "task_id": {
      "kind": "from_response",
      "step": "create_task",
      "json": "$.id",
      "example": "1090332016"
    }
  },
  "driver": {
    "project_name": "box20",
    "dev_id": "090000000000001",
    "access_code": "1234abcd",
    "plate_index": 1,
    "task_bed_type": "eng_plate",
    "task_use_ams": true,
    "task_record_timelapse": true,
    "task_layer_inspect": true,
    "task_bed_leveling": false,
    "task_flow_cali": false,
    "task_vibration_cali": false,
    "auto_bed_leveling": 2,
    "auto_flow_cali": 2,
    "auto_offset_cali": 2,
    "extruder_cali_manual_mode": 0,
    "ftp_file_md5": "C243A8A7648BDB3ECF89978D795105B7",
    "ams_mapping": "[2,128]",
    "ams_mapping2": "[{\"ams_id\":0,\"slot_id\":2},{\"ams_id\":128,\"slot_id\":0}]",
    "ams_mapping_info": "[{\"ams\":2,\"filamentId\":\"GFN04\",\"filamentType\":\"PA-CF\",\"nozzleId\":1,\"sourceColor\":\"#000000FF\",\"targetColor\":\"000000FF\"},{\"ams\":128,\"filamentId\":\"GFB01\",\"filamentType\":\"ASA\",\"nozzleId\":1,\"sourceColor\":\"#161616FF\",\"targetColor\":\"161616FF\"}]",
    "nozzles_info": "",
    "asset": "assets/box20.gcode.3mf",
    "config_asset": "assets/box20_config.3mf"
  },
  "steps": [
    {
      "seq": 1,
      "id": "ftp_upload_to_printer",
      "protocol": "ftp",
      "channel_only": "lan",
      "request": {
        "host": "{{device_id}}:990",
        "tls": "implicit-990",
        "auth": "USER bblp / PASS <access_code>",
        "op": "STOR",
        "path": "/{{remote_gcode_name}}"
      },
      "expect": {
        "reply": "226 Transfer complete"
      }
    },
    {
      "seq": 2,
      "id": "mqtt_publish_project_file",
      "protocol": "mqtt",
      "channel_only": "lan",
      "request": {
        "broker": "device/{{device_id}}/request via LAN MQTT (mTLS :8883 in production; plain in the mock)",
        "topic": "device/{{device_id}}/request",
        "payload_json": {
          "print": {
            "command": "project_file",
            "param": "Metadata/plate_{{plate_index}}.gcode",
            "project_id": "{{project_id}}",
            "profile_id": "{{profile_id}}",
            "task_id": "{{task_id}}",
            "subtask_id": "0",
            "subtask_name": "box20",
            "url": "ftp://{{remote_gcode_name}}",
            "md5": "{{gcode_md5}}"
          }
        }
      },
      "expect": {},
      "notes": "[J] LAN leg 2 (after create_task): publish project_file to device/<serial>/request (QoS0, fire-and-forget). LAN channel carries the CLEARTEXT local fetch url (ftp://<name>) \u2014 no url_enc (that RSA-encrypted field is the cloud-channel path). NOTE: on a cloud-bound printer the genuine plugin sends project_file over CLOUD mqtt, not this LAN topic; the OSS/bridge publish it here and the firmware accepts it. Asserted live against MqttBrokerMock (topic + print.command==project_file + print.url startswith ftp://)."
    }
  ]
}
