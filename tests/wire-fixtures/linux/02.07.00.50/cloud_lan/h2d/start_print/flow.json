{
  "schema": "obn-wire-flow/v1",
  "meta": {
    "os": "linux",
    "network_plugin_version": "02.07.00.50",
    "slicer_client_version": "02.07.00.55",
    "channel": "cloud_lan",
    "printer_model": "h2d",
    "flow": "start_print",
    "source": "BambuStudio"
  },
  "identity_block": {
    "order": [
      "Host",
      "User-Agent",
      "X-BBL-Client-ID",
      "X-BBL-Client-Name",
      "X-BBL-Client-Type",
      "X-BBL-Client-Version",
      "X-BBL-Device-ID",
      "X-BBL-Language",
      "X-BBL-OS-Type",
      "X-BBL-OS-Version",
      "X-BBL-Agent-Version",
      "X-BBL-Executable-info",
      "X-BBL-Agent-OS-Type",
      "X-BBL-Executable-Env",
      "accept",
      "Authorization",
      "Content-Type"
    ],
    "values": {
      "Host": "api.bambulab.com",
      "User-Agent": "bambu_network_agent/02.07.00.50",
      "X-BBL-Client-ID": "<dynamic:slicer:{user_id}:{hex4}>",
      "X-BBL-Client-Name": "BambuStudio",
      "X-BBL-Client-Type": "slicer",
      "X-BBL-Client-Version": "02.07.00.55",
      "X-BBL-Device-ID": "<dynamic:install-uuid>",
      "X-BBL-Language": "en-US",
      "X-BBL-OS-Type": "linux",
      "X-BBL-OS-Version": "5.15.0",
      "X-BBL-Agent-Version": "02.07.00.50",
      "X-BBL-Executable-info": "{}",
      "X-BBL-Agent-OS-Type": "linux",
      "X-BBL-Executable-Env": "false",
      "accept": "application/json",
      "Authorization": "<dynamic:Bearer access_token>",
      "Content-Type": "application/json"
    }
  },
  "vars": {
    "job_name": {
      "kind": "input",
      "example": "box20"
    },
    "plate_index": {
      "kind": "input",
      "example": 1
    },
    "device_id": {
      "kind": "session",
      "example": "090000000000002"
    },
    "user_id": {
      "kind": "session",
      "example": "1234567890"
    },
    "project_id": {
      "kind": "from_response",
      "step": "create_project",
      "json": "$.project_id",
      "example": "899132772"
    },
    "profile_id": {
      "kind": "from_response",
      "step": "create_project",
      "json": "$.profile_id",
      "example": "874689065"
    },
    "model_id": {
      "kind": "from_response",
      "step": "create_project",
      "json": "$.model_id",
      "example": "US00000000000002"
    },
    "upload_url": {
      "kind": "from_response",
      "step": "create_project",
      "json": "$.upload_url",
      "example": "<presigned S3 url>"
    },
    "upload_ticket": {
      "kind": "from_response",
      "step": "create_project",
      "json": "$.upload_ticket",
      "example": "uploader_1234567890_US00000000000002_874689065_20260714204852.11"
    },
    "config_file_name": {
      "kind": "generated",
      "example": ".1748171.1_config.3mf"
    },
    "gcode_md5": {
      "kind": "input",
      "example": "C7BDBECECC110390EC3153AE486FD8DE"
    },
    "main_upload_url": {
      "kind": "from_response",
      "step": "get_upload_url",
      "json": "$.urls[0].url",
      "example": "https://s3.us-west-2.amazonaws.com/or-cloud-upload-prod/users/1234567890/models/.../US00000000000002_874689065_1.3mf?AWSAccessKeyId=...&Expires=...&Signature=..."
    },
    "seq": {
      "kind": "generated",
      "example": "20002"
    },
    "task_id": {
      "kind": "from_response",
      "step": "create_task",
      "json": "$.id",
      "example": "1090358500"
    }
  },
  "driver": {
    "project_name": "box20",
    "dev_id": "090000000000002",
    "access_code": "1234abcd",
    "plate_index": 1,
    "task_bed_type": "textured_plate",
    "task_use_ams": true,
    "task_record_timelapse": true,
    "task_layer_inspect": true,
    "task_bed_leveling": false,
    "task_flow_cali": false,
    "task_vibration_cali": false,
    "auto_bed_leveling": 2,
    "auto_flow_cali": 2,
    "auto_offset_cali": 2,
    "extruder_cali_manual_mode": 0,
    "ftp_file_md5": "C7BDBECECC110390EC3153AE486FD8DE",
    "ams_mapping": "[5,3]",
    "ams_mapping2": "[{\"ams_id\":1,\"slot_id\":1},{\"ams_id\":0,\"slot_id\":3}]",
    "ams_mapping_info": "[{\"ams\":5,\"filamentId\":\"GFG00\",\"filamentType\":\"PETG\",\"nozzleId\":1,\"sourceColor\":\"#161616FF\",\"targetColor\":\"161616FF\"},{\"ams\":3,\"filamentId\":\"GFG00\",\"filamentType\":\"PETG\",\"nozzleId\":0,\"sourceColor\":\"#FFF144FF\",\"targetColor\":\"FFF144FF\"}]",
    "nozzles_info": "[{\"diameter\":0.4,\"flowSize\":\"standard_flow\",\"id\":1,\"type\":null},{\"diameter\":0.4,\"flowSize\":\"standard_flow\",\"id\":0,\"type\":null}]",
    "asset": "assets/box20.gcode.3mf",
    "config_asset": "assets/box20_config.3mf"
  },
  "steps": [
    {
      "seq": 1,
      "id": "create_project",
      "protocol": "http",
      "request": {
        "method": "POST",
        "host": "api.bambulab.com",
        "path": "/v1/iot-service/api/user/project",
        "headers": {
          "block": true,
          "client_id": true,
          "content_type": true,
          "authorization": true
        },
        "body_json": {
          "name": "box20"
        }
      },
      "expect": {
        "status": 200
      },
      "captures": {
        "project_id": "$.project_id",
        "profile_id": "$.profile_id",
        "model_id": "$.model_id",
        "upload_url": "$.upload_url",
        "upload_ticket": "$.upload_ticket"
      }
    },
    {
      "seq": 2,
      "id": "upload_config_3mf",
      "protocol": "http",
      "request": {
        "method": "PUT",
        "host": "<presigned>",
        "path": "{{upload_url}}",
        "headers": {
          "block": false,
          "content_type_removed": true,
          "expect_removed": true
        },
        "body_raw": "<config .3mf bytes>"
      },
      "expect": {
        "status": 200
      }
    },
    {
      "seq": 3,
      "id": "notify_upload",
      "protocol": "http",
      "request": {
        "method": "PUT",
        "host": "api.bambulab.com",
        "path": "/v1/iot-service/api/user/notification",
        "headers": {
          "block": true,
          "client_id": true,
          "content_type": true,
          "authorization": true
        },
        "body_json": {
          "upload": {
            "origin_file_name": "{{config_file_name}}",
            "ticket": "{{upload_ticket}}"
          }
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "seq": 4,
      "id": "poll_upload",
      "protocol": "http",
      "repeatable": true,
      "request": {
        "method": "GET",
        "host": "api.bambulab.com",
        "path": "/v1/iot-service/api/user/notification",
        "query": {
          "action": "upload",
          "ticket": "{{upload_ticket}}"
        },
        "headers": {
          "block": true,
          "client_id": true,
          "content_type": false,
          "authorization": true
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "seq": 5,
      "id": "patch_project_placeholder",
      "protocol": "http",
      "channel_only": "cloud_lan",
      "request": {
        "method": "PATCH",
        "host": "api.bambulab.com",
        "path": "/v1/iot-service/api/user/project/{{project_id}}",
        "headers": {
          "block": true,
          "client_id": true,
          "content_type": true,
          "authorization": true
        },
        "body_json": {
          "profile_id": "{{profile_id}}",
          "profile_print_3mf": [
            {
              "md5": "{{gcode_md5}}",
              "plate_idx": "{{plate_index}}",
              "url": "ftp://box20.gcode.3mf"
            }
          ]
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "seq": 6,
      "id": "get_my_setting",
      "protocol": "http",
      "channel_only": "cloud_lan",
      "request": {
        "method": "GET",
        "host": "api.bambulab.com",
        "path": "/v1/user-service/my/setting",
        "headers": {
          "block": true,
          "client_id": true,
          "content_type": true,
          "authorization": true
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "seq": 7,
      "id": "get_upload_url",
      "protocol": "http",
      "request": {
        "method": "GET",
        "host": "api.bambulab.com",
        "path": "/v1/iot-service/api/user/upload",
        "query": {
          "models": "{{model_id}}_{{profile_id}}_{{plate_index}}.3mf"
        },
        "headers": {
          "block": true,
          "client_id": true,
          "content_type": false,
          "authorization": true
        }
      },
      "expect": {
        "status": 200
      },
      "captures": {
        "main_upload_url": "$.urls[0].url"
      }
    },
    {
      "seq": 8,
      "id": "upload_main_3mf",
      "protocol": "http",
      "request": {
        "method": "PUT",
        "host": "<presigned>",
        "path": "{{main_upload_url}}",
        "headers": {
          "block": false,
          "content_type_removed": true,
          "expect_removed": true
        },
        "body_raw": "<print-ready .3mf (with gcode) bytes>"
      },
      "expect": {
        "status": 200
      }
    },
    {
      "seq": 9,
      "id": "patch_project_real",
      "protocol": "http",
      "request": {
        "method": "PATCH",
        "host": "api.bambulab.com",
        "path": "/v1/iot-service/api/user/project/{{project_id}}",
        "headers": {
          "block": true,
          "client_id": true,
          "content_type": true,
          "authorization": true
        },
        "body_json": {
          "profile_id": "{{profile_id}}",
          "profile_print_3mf": [
            {
              "md5": "{{gcode_md5}}",
              "plate_idx": "{{plate_index}}",
              "url": "{{main_upload_url}}"
            }
          ]
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "seq": 10,
      "id": "ftp_upload_to_printer",
      "protocol": "ftp",
      "channel_only": "cloud_lan",
      "request": {
        "host": "{{device_id}}:990",
        "tls": "implicit-990",
        "auth": "USER bblp / PASS <access_code>",
        "op": "STOR",
        "path": "/{{remote_gcode_name}}"
      },
      "expect": {
        "reply": "226 Transfer complete"
      }
    },
    {
      "seq": 11,
      "id": "create_task",
      "protocol": "http",
      "body_builder": true,
      "request": {
        "method": "POST",
        "host": "api.bambulab.com",
        "path": "/v1/user-service/my/task",
        "headers": {
          "block": true,
          "client_id": true,
          "content_type": true,
          "authorization": true
        },
        "body_json": {
          "amsDetailMapping": [
            {
              "ams": 5,
              "filamentId": "GFG00",
              "filamentType": "PETG",
              "nozzleId": 1,
              "sourceColor": "#161616FF",
              "targetColor": "161616FF"
            },
            {
              "ams": 3,
              "filamentId": "GFG00",
              "filamentType": "PETG",
              "nozzleId": 0,
              "sourceColor": "#FFF144FF",
              "targetColor": "FFF144FF"
            }
          ],
          "amsMapping": [
            5,
            3
          ],
          "amsMapping2": [
            {
              "amsId": 1,
              "slotId": 1
            },
            {
              "amsId": 0,
              "slotId": 3
            }
          ],
          "autoBedLeveling": 2,
          "bedLeveling": false,
          "bedType": "textured_plate",
          "cfg": "0",
          "cover": "",
          "deviceId": "090000000000002",
          "extrudeCaliFlag": 2,
          "extrudeCaliManualMode": 0,
          "filamentSettingIds": [],
          "flowCali": false,
          "layerInspect": true,
          "mode": "lan_file",
          "modelId": "{{model_id}}",
          "nozzleInfos": [
            {
              "diameter": 0.4,
              "flowSize": "standard_flow",
              "id": 1,
              "type": null
            },
            {
              "diameter": 0.4,
              "flowSize": "standard_flow",
              "id": 0,
              "type": null
            }
          ],
          "nozzleOffsetCali": 2,
          "oriModelId": "",
          "oriProfileId": 0,
          "plateIndex": 1,
          "profileId": "{{profile_id}}",
          "sequence_id": "{{seq}}",
          "timelapse": true,
          "title": "box20",
          "useAms": true,
          "vibrationCali": false
        }
      },
      "expect": {
        "status": 200
      },
      "captures": {
        "task_id": "$.id"
      }
    },
    {
      "seq": 12,
      "id": "poll_task",
      "protocol": "http",
      "repeatable": true,
      "request": {
        "method": "GET",
        "host": "api.bambulab.com",
        "path": "/v1/user-service/my/task/{{task_id}}",
        "headers": {
          "block": true,
          "client_id": true,
          "content_type": false,
          "authorization": true
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "seq": 13,
      "id": "mqtt_publish_project_file",
      "protocol": "mqtt",
      "channel_only": "cloud_lan",
      "request": {
        "broker": "device/{{device_id}}/request via LAN MQTT (mTLS :8883 in production; plain in the mock)",
        "topic": "device/{{device_id}}/request",
        "payload_json": {
          "print": {
            "command": "project_file",
            "param": "Metadata/plate_{{plate_index}}.gcode",
            "project_id": "{{project_id}}",
            "profile_id": "{{profile_id}}",
            "task_id": "{{task_id}}",
            "subtask_id": "0",
            "subtask_name": "box20",
            "url": "ftp://{{remote_gcode_name}}",
            "md5": "{{gcode_md5}}"
          }
        }
      },
      "expect": {},
      "notes": "[J] LAN leg 2 (after create_task): publish project_file to device/<serial>/request (QoS0, fire-and-forget). LAN channel carries the CLEARTEXT local fetch url (ftp://<name>) \u2014 no url_enc (that RSA-encrypted field is the cloud-channel path). NOTE: on a cloud-bound printer the genuine plugin sends project_file over CLOUD mqtt, not this LAN topic; the OSS/bridge publish it here and the firmware accepts it. Asserted live against MqttBrokerMock (topic + print.command==project_file + print.url startswith ftp://)."
    }
  ]
}